# Database
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# SMTP (Ethereal — generate at https://ethereal.email)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate limiting
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MIN_DELAY_MS_BETWEEN_SENDS=2000
WORKER_CONCURRENCY=3

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000

# Frontend on Vercel
BACKEND_URL=https://reachinbox-backend.onrender.com
